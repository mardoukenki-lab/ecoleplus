rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isAuthenticated() && request.auth.token != null && (
        ('email' in request.auth.token && request.auth.token.email == 'mardoukenki@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email.matches('.*@akpanyschool\\.store$'))
      );
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role verification: Uses Bootstrapped Admin runtime email, Firebase Auth Custom Claims, or Firestore User Role
    function isAdmin() {
      return isAuthenticated() && (
        isBootstrappedAdmin() ||
        (request.auth.token != null && 'admin' in request.auth.token && request.auth.token.admin == true) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role == 'admin')
      );
    }

    function isActiveUser() {
      return isAuthenticated() && (
        isAdmin() || 
        (hasUserDoc() && 'status' in getUserData() && getUserData().status == 'active')
      );
    }

    function isProf() {
      return isAuthenticated() && (
        isAdmin() ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role == 'prof')
      );
    }

    function isParent() {
      return isAuthenticated() && (
        isAdmin() ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role == 'parent')
      );
    }

    function isParentOfEleve(eleveId) {
      return isAuthenticated() && hasUserDoc() && (
        ('enfants' in getUserData() && getUserData().enfants != null && eleveId in getUserData().enfants)
      );
    }

    // Multi-tenant isolation helper functions
    function getEtablissementId() {
      return (hasUserDoc() && 'etablissementId' in getUserData() && getUserData().etablissementId != null)
        ? getUserData().etablissementId
        : 'akpany-principal';
    }

    // Enforce multi-tenant read access with admin bypass and default establishment fallback
    function belongsToSameEtablissement() {
      return isAdmin() || (
        isAuthenticated() && (
          !('etablissementId' in resource.data) ||
          resource.data.etablissementId == getEtablissementId() ||
          resource.data.etablissementId == 'akpany-principal'
        )
      );
    }

    // Enforce multi-tenant write access with admin bypass and default establishment fallback
    function writeBelongsToSameEtablissement() {
      return isAdmin() || (
        isAuthenticated() && (
          !('etablissementId' in request.resource.data) ||
          request.resource.data.etablissementId == getEtablissementId() ||
          request.resource.data.etablissementId == 'akpany-principal'
        )
      );
    }

    // Users collection: user can manage own document without privilege escalation, admin can manage all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          !('role' in request.resource.data) || request.resource.data.role != 'admin'
        ))
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role ||
          (resource.data.role != 'admin' && request.resource.data.role != 'admin')
        ))
      );
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Audit logs: Read by Admin only, Append-only creation by authenticated users, never deleted or modified
    match /audit_log/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Eleves: Authenticated read in same etablissement (or code verification for matricule check), Admin or Parent updating linked child
    match /eleves/{docId} {
      allow read: if isAuthenticated() || (resource.data != null && 'code' in resource.data);
      allow create: if isAdmin() && writeBelongsToSameEtablissement();
      allow update: if writeBelongsToSameEtablissement() && (isAdmin() || (isAuthenticated() && (isParentOfEleve(docId) || isParentOfEleve(request.resource.data.id))));
      allow delete: if isAdmin();
    }

    // Paiements: Read by admin, teachers, or parents for their children; Write restricted to Admin
    match /paiements/{docId} {
      allow read: if belongsToSameEtablissement() && (
        isAdmin() || isProf() || (
          isAuthenticated() && (
            (resource.data.parentEmail == request.auth.token.email) ||
            (resource.data.parentUid == request.auth.uid) ||
            isParentOfEleve(resource.data.eleveId)
          )
        )
      );
      allow create, update, delete: if isAdmin() && writeBelongsToSameEtablissement();
    }

    // Paiement requests: Parents initiate transaction intents securely without modifying balances
    match /paiement_requests/{requestId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement() && (
        isAdmin() ||
        resource.data.parentUid == request.auth.uid ||
        isParentOfEleve(resource.data.eleveId)
      );
      allow create: if isAuthenticated() && writeBelongsToSameEtablissement() && (
        request.resource.data.parentUid == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      allow update, delete: if isAdmin();
    }

    // Notes: Multi-tenant read, Admin/Prof write
    match /notes/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // Absences: Multi-tenant read, Admin/Prof write
    match /absences/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // Annonces: Multi-tenant read, Admin/Prof write
    match /annonces/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // Cahier_texte: Multi-tenant read, Admin/Prof write
    match /cahier_texte/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // Notifications: Multi-tenant aware read & write
    match /notifications/{docId} {
      allow read: if isAuthenticated() && (
        isAdmin() || !('etablissementId' in resource.data) || resource.data.etablissementId == getEtablissementId()
      );
      allow write: if isAuthenticated() && (
        isAdmin() || !('etablissementId' in request.resource.data) || request.resource.data.etablissementId == getEtablissementId()
      );
    }

    // SMS_queue: Authenticated read & write
    match /sms_queue/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Messages: Authenticated read & write in establishment
    match /messages/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isAuthenticated() && writeBelongsToSameEtablissement();
    }

    // Schedules (Emploi du temps): Multi-tenant read, Admin/Prof write
    match /schedules/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // Observations: Multi-tenant read, Admin/Prof write
    match /observations/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // Classes collection: Multi-tenant read, Admin write
    match /classes/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isAdmin() && writeBelongsToSameEtablissement();
    }

    // Examens & Épreuves: Multi-tenant read, Admin/Prof write
    match /examens/{docId} {
      allow read: if isAuthenticated() && belongsToSameEtablissement();
      allow write: if isProf() && writeBelongsToSameEtablissement();
    }

    // FCM Push Tokens: Authenticated users manage their device tokens, Admin can audit
    match /fcm_tokens/{tokenId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }
  }
}
